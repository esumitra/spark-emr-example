#!/bin/bash
#Need to skip output if non interactive, for scp
case "$-" in
    *i*) ;;        # interactive shell → allow output
    *) return ;;   # non-interactive → no output
esac
#Install java if not present
check=`which java`
if [ "$check" = "" ]
then
    sudo yum install -y java-17-amazon-corretto-headless
fi
aws sts get-caller-identity
#KAFKA_BROKERS_ALL generated below
set -v
export KAFKA_BROKERS_ALL="%KAFKA_BROKERS_ALL%"
set +v

